# ---------------------------------------------------------------------------
# Fanvue OAuth. Create an app in the Fanvue Developer area (creators with KYC
# only) to get these: https://fanvue.com/developers
# ---------------------------------------------------------------------------
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Must match the redirect URI registered in the Fanvue developer UI, character
# for character. Fanvue requires HTTPS even in local development; see
# docs/engineering-notes.md.
OAUTH_REDIRECT_URI="https://offer-ladder.dev:3001/api/oauth/callback"

# Must match the scopes ticked in the Fanvue developer UI.
# read:chat is requested only because GET /chats/lists/smart and
# GET /chats/mass-messages require it. This app never reads a conversation.
OAUTH_SCOPES="read:self read:creator write:creator read:insights read:fan read:chat write:chat"

# The starter adds openid, offline_access and offline itself, which is what
# makes refresh tokens work. Do not add them here.
OAUTH_ISSUER_BASE_URL=https://auth.fanvue.com
API_BASE_URL=https://api.fanvue.com

# Where this app is served. Must be https in production.
BASE_URL=https://offer-ladder.dev:3001

# Session cookie name, and the secret it's encrypted with (16+ characters).
SESSION_COOKIE_NAME=offers_session
SESSION_SECRET=replace-me-with-a-random-string

# ---------------------------------------------------------------------------
# Message drafting. Optional: without these the built-in wording is used.
# Any OpenAI-compatible endpoint works. For OpenRouter, turn on zero data
# retention in your OpenRouter privacy settings, then:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=deepseek/deepseek-chat
# ---------------------------------------------------------------------------
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# AI drafts per hour: shared by everyone in the demo, and per connected creator
# (default 3). The demo is public.
LLM_HOURLY_LIMIT=3

# ---------------------------------------------------------------------------
# Shared store for the drafting budget and History. Optional locally (an
# in-memory map is used); needed in production. Vercel's Upstash integration
# sets the KV_* names for you.
# ---------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
